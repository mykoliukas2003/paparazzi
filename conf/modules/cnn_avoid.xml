<!DOCTYPE module SYSTEM "module.dtd">

<module name="cnn_avoid" dir="cnn_avoid">
  <doc>
    <description>
      CNN-depth based obstacle avoidance with trajectory following.
      Reads the navigation vector from the cnn_vision module and
      uses a confidence-based state machine to avoid obstacles while
      following circle, figure-eight, or lawnmower trajectories.
    </description>
  </doc>


   
  <settings>
    <dl_settings>
      <dl_settings name="CNN Avoidance">
        <dl_setting var="cnn_safe_distance_threshold"    min="0.0" step="0.01" max="1.0" shortname="safe_thr"/>
        <dl_setting var="cnn_caution_distance_threshold" min="0.0" step="0.01" max="1.0" shortname="caution_thr"/>
        <dl_setting var="cnn_caution_exit_threshold"     min="0.0" step="0.01" max="1.0" shortname="caution_exit"/>
        <dl_setting var="cnn_depth_filter_alpha"         min="0.0" step="0.05" max="1.0" shortname="filter_alpha"/>
        <dl_setting var="cnn_max_distance"               min="0.0" step="0.1"  max="5.0" shortname="max_dist"/>
      </dl_settings>
      <dl_settings name="CNN Trajectory">
        <dl_setting var="traj_circle_radius" min="0.5" step="0.1" max="5.0" shortname="circle_r"/>
        <dl_setting var="traj_circle_speed"  min="0.01" step="0.01" max="0.5" shortname="circle_spd"/>
        <dl_setting var="traj_eight_scale"   min="0.5" step="0.1" max="5.0" shortname="eight_scale"/>
        <dl_setting var="traj_lawn_step"     min="0.1" step="0.1" max="3.0" shortname="lawn_step"/>
      </dl_settings>
    </dl_settings>
  </settings>
  
  <dep>
  <depends>cnn_vision</depends>
  </dep>

  <header>
    <file name="cnn_avoid.h"/>
  </header>

  <init fun="cnn_avoid_init()"/>
  <periodic fun="cnn_avoid_periodic()" freq="4"/>

  <makefile target="ap|nps">
    <file name="cnn_avoid.c"/>
    <flag name="LDFLAGS" value="lm"/>
  </makefile>
</module>

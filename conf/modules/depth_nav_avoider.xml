<!DOCTYPE module SYSTEM "module.dtd">

<module name="depth_nav_avoider">
  <doc>
    <description>
    Combined depth and confidence based obstacle avoider.
    Uses depth estimates (left/straight/right) from cv_estimate_depth
    with a multi-state confidence system for robust obstacle avoidance.
    </description>
    <define name="ORANGE_AVOIDER_VISUAL_DETECTION_ID" value="ABI_BROADCAST" 
            description="Which VISUAL_DETECTION message to receive for depth estimates."/>
  </doc>

  <settings>
    <dl_settings>
      <dl_settings name="Depth Nav Avoidance">
        <dl_setting var="safe_distance_threshold"    min="0" step="1" max="255" shortname="safe_thr"/>
        <dl_setting var="caution_distance_threshold" min="0" step="1" max="255" shortname="caution_thr"/>
        <dl_setting var="depth_filter_alpha"         min="0.0" step="0.05" max="1.0" shortname="filter_alpha"/>
        <dl_setting var="maxDistance"                 min="0.0" step="0.1" max="5.0" shortname="max_dist"/>
        <dl_setting var="traj_circle_radius" min="0.5" step="0.1" max="5.0" shortname="circle_r"/>
        <dl_setting var="traj_circle_speed"  min="0.01" step="0.01" max="0.5" shortname="circle_spd"/>
        <dl_setting var="traj_eight_scale"   min="0.5" step="0.1" max="5.0" shortname="eight_scale"/>
        <dl_setting var="traj_lawn_step"     min="0.1" step="0.1" max="3.0" shortname="lawn_step"/>
      </dl_settings>
    </dl_settings>
  </settings>

  <dep>
    <depends>cv_estimate_depth</depends>
  </dep>

  <header>
    <file name="depth_nav_avoider.h"/>
  </header>
  <init fun="depth_nav_avoider_init()"/>
  <periodic fun="depth_nav_avoider_periodic()" freq="2"/>
  <makefile target="ap|nps">
    <file name="depth_nav_avoider.c"/>
  </makefile>
</module>
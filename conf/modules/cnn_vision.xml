<!DOCTYPE module SYSTEM "module.dtd">

<module name="cnn_vision" dir="computer_vision/cnn_vision">
  <doc>
    <description>
      CNN-based monocular depth estimation.
      Runs an ONNX model on the front camera and produces a 7-element
      navigation vector (max depth per horizontal strip).
    </description>
  </doc>


  <settings>
  <dl_settings>
    <dl_settings name="CNN Vision">
      <dl_setting var="cnn_vision_draw" min="0" step="1" max="1" values="Off|On" shortname="draw"/>
    </dl_settings>
  </dl_settings>
  </settings>


  <dep>
  <depends>video_thread</depends>
  </dep>

  <header>
    <file name="cnn_vision.h"/>
  </header>



  <init fun="cnn_vision_init()"/>

  <makefile target="ap|nps">
    <file name="cnn_vision.c"/>
    <flag name="LDFLAGS" value="lm"/>
    <flag name="LDFLAGS" value="lonnxruntime"/>
    <define name="CNN_VISION_CAMERA" value="front_camera" cond="ifndef CNN_VISION_CAMERA"/>
    <define name="CNN_VISION_FPS" value="5" cond="ifndef CNN_VISION_FPS"/>
    <define name="CNN_VISION_ASYNC_NICE" value="0" cond="ifndef CNN_VISION_ASYNC_NICE"/>
  </makefile>
</module>
